{
  "manifest_version": 3,
  "name": "BCP Target Inspector",
  "version": "2.1.0",
  "description": "Intercepta llamadas mbox/interact de Adobe Target",
  "permissions": ["storage", "tabs", "scripting"],
  "host_permissions": ["*://*.viabcp.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "assets/icon16.svg",
    "48": "assets/icon48.svg",
    "128": "assets/icon128.svg"
  },
  "action": {
    "default_title": "BCP Target Inspector",
    "default_icon": {
      "16": "assets/icon16.svg",
      "48": "assets/icon48.svg",
      "128": "assets/icon128.svg"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://*.viabcp.com/*"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://*.viabcp.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
