{
  "manifest_version": 3,
  "name": "mBox Inspector",
  "version": "2.0.0",
  "description": "Intercepta llamadas mbox/interact de Adobe Target",
  "permissions": ["storage", "tabs", "scripting"],
  "host_permissions": [
    "*://*.viabcp.com/*",
    "*://*.yoando.com.pe/*"
  ],
  "icons": {
    "16": "assets/icon16.svg",
    "48": "assets/icon48.svg",
    "128": "assets/icon128.svg"
  },
  "action": {
    "default_title": "mBox Inspector",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icon16.svg",
      "48": "assets/icon48.svg",
      "128": "assets/icon128.svg"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.viabcp.com/*",
        "*://*.yoando.com.pe/*"
      ],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.viabcp.com/*",
        "*://*.yoando.com.pe/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
